# Copiar este archivo como .env y poner los valores reales
# (el .env NO se sube a github, esta en el .gitignore)
PORT=3000
NODE_ENV=development
# local: mongodb://127.0.0.1:27017/potion-lab   |   Atlas: mongodb+srv://usuario:clave@cluster.mongodb.net/potion-lab
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/potion-lab
# Usa un texto aleatorio largo. No copies este valor de ejemplo al .env real.
JWT_SECRET=pon_aqui_un_secreto_de_32_caracteres_o_mas
JWT_EXPIRES_IN=7d
# url del front, separadas por coma si son varias (vacio = permite todas)
CORS_ORIGIN=http://localhost:5173
